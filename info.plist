				<string>ObjC.import("Foundation")

function run(argv) {
  const query = argv.join(" ").trim()
  const environment = $.NSProcessInfo.processInfo.environment
  const dataDirectory = environment.objectForKey("alfred_workflow_data").js
  const timestampFile = `${dataDirectory}/start_timestamp`
  const fileManager = $.NSFileManager.defaultManager

  let startTimestamp = 0

  if (fileManager.fileExistsAtPath(timestampFile)) {
    try {
      const contents = $.NSString
        .stringWithContentsOfFileEncodingError(
          timestampFile,
          $.NSUTF8StringEncoding,
          null
        )
        .js
        .trim()

      startTimestamp = Number(contents)
    } catch (error) {
      startTimestamp = 0
    }
  }

  const sessionActive =
    Number.isFinite(startTimestamp) &amp;&amp;
    startTimestamp &gt; 0

  const items = []

  // Only show the timer for plain "fl".
  if (sessionActive &amp;&amp; query === "") {
    const now = Math.floor(Date.now() / 1000)
    const elapsed = Math.max(0, now - startTimestamp)

    items.push({
      uid: "flowmodoro-timer",
      title: `Flowing · ${formatDuration(elapsed)}`,
      valid: false
    })
  }

  if (sessionActive) {
    items.push({
      uid: "flowmodoro-break",
      title: "End focus session",
      match: "break end stop finish",
      arg: "break"
    })
  } else {
    items.push({
      uid: "flowmodoro-start",
      title: "Start focus session",
      match: "start begin focus",
      arg: "start"
    })
  }

  items.push(
    {
      uid: "flowmodoro-toggle",
      title: "Toggle background sounds",
      match: "toggle bs background sounds",
      arg: "toggle",
      icon: {
        path: "note.png"
      }
    },
    {
      uid: "flowmodoro-change",
      title: "Change background sounds",
      match: "change choose background sounds",
      arg: "change",
      icon: {
        path: "note.png"
      }
    }
  )

  const output = { 
    skipknowledge: true,
	items 
  }

  // Update the visible timer every second.
  if (sessionActive &amp;&amp; query === "") {
    output.rerun = 1
  }

  return JSON.stringify(output)
}

function formatDuration(totalSeconds) {
  const hours = Math.floor(totalSeconds / 3600)
  const minutes = Math.floor((totalSeconds % 3600) / 60)
  const seconds = totalSeconds % 60

  if (hours &gt; 0) {
    return [
      hours,
      String(minutes).padStart(2, "0"),
      String(seconds).padStart(2, "0")
    ].join(":")
  }

  return [
    String(minutes).padStart(2, "0"),
    String(seconds).padStart(2, "0")
  ].join(":")
}</string>
