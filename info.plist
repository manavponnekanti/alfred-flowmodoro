				<string>timestamp_file="$alfred_workflow_data/start_timestamp"

if [[ ! -f "$timestamp_file" ]]; then
  printf 'No active Flowmodoro session' &gt;&amp;2
  exit 1
fi

start_timestamp=$(&lt;"$timestamp_file")
current_timestamp=$(date +%s)

if [[ ! "$start_timestamp" =~ '^[0-9]+$' ]]; then
  printf 'Invalid start timestamp' &gt;&amp;2
  exit 1
fi

elapsed_seconds=$((current_timestamp - start_timestamp))

rm "$timestamp_file"

printf '%d' "$elapsed_seconds"</string>
